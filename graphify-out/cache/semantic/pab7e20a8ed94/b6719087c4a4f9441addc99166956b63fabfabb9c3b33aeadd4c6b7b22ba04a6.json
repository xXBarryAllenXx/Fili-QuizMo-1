{"nodes": [{"id": "public_assets_fill_in_the_blanks_fill_in_the_blanks", "label": "Fill in the Blanks Quiz Screen", "file_type": "image", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-screen mobile quiz UI captured as a promotional/asset screenshot; retro pixel-art game framing turns a language quiz into a playful game loop rather than a plain form."}, {"id": "public_assets_fill_in_the_blanks_punan_ang_blangko_mode", "label": "Punan ang Blangko Mode", "file_type": "concept", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "top HUD label, left of 1/5 counter", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Naming the game mode in Filipino keeps the entire experience monolingual and immediately signals the task type (fill in the blank) before the question is read."}, {"id": "public_assets_fill_in_the_blanks_tanong_question_card", "label": "Tanong Question Card", "file_type": "concept", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "yellow banner and cream card, upper middle", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A high-contrast cream card with a bold yellow 'TANONG 1' banner isolates the prompt from the rest of the screen so the sentence being completed is the visual focus; the blank is rendered as a long underscore to invite completion."}, {"id": "public_assets_fill_in_the_blanks_answer_input", "label": "Your Answer Text Input", "file_type": "concept", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "middle, under 'Your answer:'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A free-text field with placeholder 'Type your answer...' lets learners produce the word themselves instead of only recognizing it, which tests recall rather than recognition."}, {"id": "public_assets_fill_in_the_blanks_answer_choices", "label": "Answer Choice Buttons", "file_type": "concept", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "lower middle, under 'Choices:'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four tappable word options (makamandag, malinis, mabilis, malalim) provide a recognition-based assist path and reduce typing friction on mobile; all are adjectives so the learner must judge meaning against the sentence context."}, {"id": "public_assets_fill_in_the_blanks_clear_button", "label": "Clear Button", "file_type": "concept", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "lower left, below the choices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dedicated reset control lets players undo a mistaken typed or tapped answer without leaving the question."}, {"id": "public_assets_fill_in_the_blanks_next_button", "label": "Next Button", "file_type": "concept", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "bottom, full-width green bar", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A full-width, high-saturation green bar is the single obvious forward action, keeping the primary progression tap target large and thumb-reachable."}, {"id": "public_assets_fill_in_the_blanks_countdown_timer", "label": "Countdown Timer", "file_type": "concept", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "top HUD, clock icon with red bar and '7'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A visible per-question timer with a draining red bar adds game-like time pressure and discourages idle lookups."}, {"id": "public_assets_fill_in_the_blanks_question_progress", "label": "Question Progress 1 of 5", "file_type": "concept", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "top HUD, five segment bar and '1/5'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dual progress readout (segment pips plus a numeric 1/5) tells the player both how far along they are and how much remains, supporting session-length expectations."}, {"id": "public_assets_fill_in_the_blanks_close_button", "label": "Close Quiz Button", "file_type": "concept", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "top left HUD, green square with pink X", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A persistent exit control gives an escape hatch from a timed quiz while keeping destructive navigation visually distinct (pink X on green) from forward actions."}, {"id": "public_assets_fill_in_the_blanks_pixel_art_ui", "label": "Retro Pixel-Art UI Style", "file_type": "concept", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "entire screen styling", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chunky dark outlines, pixel fonts, beveled cream panels and an 8-bit skyline evoke nostalgic handheld RPGs, making a school quiz feel like a game and increasing engagement for student players."}, {"id": "public_assets_fill_in_the_blanks_filipino_language", "label": "Filipino Language Localization", "file_type": "concept", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "all on-screen labels and question text", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every label (Punan ang blangko, Tanong, Kumpletuhin ang pangungusap, Your answer, Choices, Clear) and the reading passage are in Filipino/Taglish, situating the quiz in a Philippine literature context."}, {"id": "public_assets_fill_in_the_blanks_pixel_city_background", "label": "Pixel Skyline Background", "file_type": "concept", "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "lower half of the screen behind the controls", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A light-blue sky, pixel clouds and a silhouetted city over water provide themed scenery without competing with the question card for attention."}], "edges": [{"source": "public_assets_fill_in_the_blanks_fill_in_the_blanks", "target": "public_assets_fill_in_the_blanks_punan_ang_blangko_mode", "relation": "depicts", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "top HUD mode label", "weight": 1.0}, {"source": "public_assets_fill_in_the_blanks_punan_ang_blangko_mode", "target": "public_assets_fill_in_the_blanks_tanong_question_card", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "mode label above the question card", "weight": 1.0}, {"source": "public_assets_fill_in_the_blanks_fill_in_the_blanks", "target": "public_assets_fill_in_the_blanks_tanong_question_card", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "central question panel", "weight": 1.0}, {"source": "public_assets_fill_in_the_blanks_fill_in_the_blanks", "target": "public_assets_fill_in_the_blanks_answer_input", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "Your answer field", "weight": 1.0}, {"source": "public_assets_fill_in_the_blanks_fill_in_the_blanks", "target": "public_assets_fill_in_the_blanks_answer_choices", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "Choices row", "weight": 1.0}, {"source": "public_assets_fill_in_the_blanks_fill_in_the_blanks", "target": "public_assets_fill_in_the_blanks_countdown_timer", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "top-right HUD", "weight": 1.0}, {"source": "public_assets_fill_in_the_blanks_fill_in_the_blanks", "target": "public_assets_fill_in_the_blanks_question_progress", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "top HUD pips and 1/5 counter", "weight": 1.0}, {"source": "public_assets_fill_in_the_blanks_fill_in_the_blanks", "target": "public_assets_fill_in_the_blanks_next_button", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "bottom green bar", "weight": 1.0}, {"source": "public_assets_fill_in_the_blanks_fill_in_the_blanks", "target": "public_assets_fill_in_the_blanks_clear_button", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "CLEAR button below choices", "weight": 1.0}, {"source": "public_assets_fill_in_the_blanks_fill_in_the_blanks", "target": "public_assets_fill_in_the_blanks_close_button", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "top-left X button", "weight": 1.0}, {"source": "public_assets_fill_in_the_blanks_fill_in_the_blanks", "target": "public_assets_fill_in_the_blanks_pixel_art_ui", "relation": "uses", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/fill_in_the_blanks.jpg", "source_location": "overall visual treatment", "weight": 1.0}, {"source": "public_assets_fill_in_the_blanks_fill_in_the_blanks", "target": "