{"nodes": [{"id": "readme_fili_quizmo", "label": "Fili-QuizMo Project Overview", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_routes", "label": "Application Route Map", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_supabase_auth", "label": "Supabase Authentication Setup", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate admin and teacher Supabase roles are enforced with server-side checks plus database policies, rather than relying on client routing or a cookie-refresh proxy."}, {"id": "readme_app_metadata_role", "label": "Trusted app_metadata.role authorization", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roles must live in trusted app_metadata (set only by a trusted administrator or server process) because user_metadata is user-editable and therefore unusable for authorization."}, {"id": "readme_admin_totp_mfa", "label": "Admin TOTP multi-factor authentication (AAL2)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admins enroll an authenticator on first password sign-in and must supply a current TOTP code afterwards; admin dashboard access additionally requires AAL2 so a stolen password alone is insufficient."}, {"id": "readme_row_level_security", "label": "Row Level Security policy enforcement", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Database policies validate trusted admin metadata and auth.jwt()->>'aal' = 'aal2' because route protection does not replace database authorization."}, {"id": "readme_server_authorization_boundary", "label": "Server routes as authorization boundary", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/admin-dashboard independently verifies user, admin role and AAL2, and /teacher-dashboard verifies user and teacher role; the proxy only refreshes Supabase cookies and is explicitly not the authorization boundary."}, {"id": "readme_webpack_build", "label": "Webpack production build choice", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The project builds with Webpack because Turbopack native bindings are unavailable in the current Windows environment."}, {"id": "readme_mock_dashboards", "label": "Mocked dashboard and registration data", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_apk_distribution", "label": "Android APK distribution", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_fili_quizmo", "target": "readme_routes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_fili_quizmo", "target": "readme_supabase_auth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_fili_quizmo", "target": "readme_mock_dashboards", "relation"