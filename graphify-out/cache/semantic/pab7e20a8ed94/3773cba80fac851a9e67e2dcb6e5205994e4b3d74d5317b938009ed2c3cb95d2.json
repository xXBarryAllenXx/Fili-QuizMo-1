{"nodes": [{"id": "public_assets_home_screen_home_screen", "label": "Fili Quiz Mo Home Screen", "file_type": "image", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Landing screen of a Filipino-language quiz game; a single dominant JOIN call-to-action with only two low-emphasis secondary actions reduces decision friction for students entering a quiz session."}, {"id": "public_assets_home_screen_title_logo", "label": "Fili Quiz Mo Title Logo", "file_type": "concept", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yellow pixel-block lettering with a drop shadow plus a small sun glyph (echoing the Philippine flag sun) establishes Filipino identity and an 8-bit retro game tone immediately on first load."}, {"id": "public_assets_home_screen_tagline_prompt", "label": "Tagline Prompt \"Ang pagkakamali ay bahagi ng pagkakatuo\"", "file_type": "concept", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Framed like a dialogue box with a downward pointer, mimicking retro RPG NPC speech to deliver an encouraging, mistake-friendly message before the quiz begins (reduces quiz anxiety)."}, {"id": "public_assets_home_screen_eagle_mascot", "label": "Philippine Eagle Mascot", "file_type": "concept", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Philippine eagle (national bird) is used as a culturally grounded guide character, standing in for a generic mascot so the game reads as distinctly Filipino."}, {"id": "public_assets_home_screen_student_role_button", "label": "Student Role Button", "file_type": "concept", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark, de-emphasized plaque shows the currently selected role; its visual weight below the mascot suggests role switching exists but is not the primary action on this screen."}, {"id": "public_assets_home_screen_join_button", "label": "JOIN Button", "file_type": "concept", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-width green button with thick outline and dark offset shadow is the highest-contrast element, following classic game 'press start' primacy on the title screen."}, {"id": "public_assets_home_screen_about_button", "label": "ABOUT Button", "file_type": "concept", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_assets_home_screen_quit_button", "label": "QUIT Button", "file_type": "concept", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_assets_home_screen_action_panel", "label": "Menu Action Panel", "file_type": "concept", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cream card with hard pixel border groups all navigation in one bottom-anchored block, keeping controls within thumb reach on a portrait mobile layout."}, {"id": "public_assets_home_screen_settings_icon_button", "label": "Top-Right Settings Icon Button", "file_type": "concept", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single small square icon in the corner (gear-like mark) holds secondary/global options, keeping the main menu uncluttered."}, {"id": "public_assets_home_screen_pixel_art_style", "label": "Pixel Art Visual Style", "file_type": "concept", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low-resolution sprite art, chunky borders and hard drop shadows are applied consistently to logo, mascot and every control so UI chrome never breaks the retro illusion."}, {"id": "public_assets_home_screen_night_sky_background", "label": "Night Sky Background with Stars and Clouds", "file_type": "concept", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deep blue gradient with scattered star pixels and a silhouetted cloud bank frames the mascot and creates calm, storybook atmosphere; high contrast keeps yellow title and green button legible."}, {"id": "public_assets_home_screen_filipino_language_ui", "label": "Filipino-Language Interface Copy", "file_type": "concept", "source_file": "public/assets/home_screen.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Narrative copy is in Filipino while navigation labels stay in English, matching bilingual Filipino student habits and keeping button affordances unambiguous."}], "edges": [{"source": "public_assets_home_screen_home_screen", "target": "public_assets_home_screen_title_logo", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/home_screen.jpg", "source_location": null, "weight": 1.0}, {"source": "public_assets_home_screen_home_screen", "target": "public_assets_home_screen_tagline_prompt", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/home_screen