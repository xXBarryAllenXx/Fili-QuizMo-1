{"nodes": [{"id": "readme_fili_quizmo", "label": "Fili-QuizMo", "file_type": "document", "source_file": "README.md", "source_location": "README.md:1-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A responsive quiz platform built with Next.js, React, and Tailwind CSS; admin and teacher authentication are deliberately separated into distinct Supabase roles, with TOTP MFA layered on top for admins."}, {"id": "readme_supabase_authentication", "label": "Supabase Authentication Setup", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:38-53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Role assignment must happen in trusted app_metadata via Supabase Auth provisioning rather than public sign-up, because user_metadata is user-editable and therefore unsafe for authorization."}, {"id": "readme_app_metadata_role", "label": "Trusted app_metadata.role Claim", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:47-48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only app_metadata.role (set by a trusted administrator or server-side process) is used for authorization; user_metadata roles are explicitly ignored, and service-role keys must never reach browser code."}, {"id": "readme_totp_mfa", "label": "Admin TOTP Multi-Factor Authentication (AAL2)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:3, 49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admins enroll an authenticator app on first password sign-in and must supply a TOTP code thereafter; the admin dashboard route independently requires AAL2 so a plain password session cannot render admin data."}, {"id": "readme_row_level_security", "label": "Row Level Security (RLS) Authorization", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:51, 53, 118", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Route protection is treated as defense in depth, not the authorization boundary: database policies must validate trusted admin metadata plus aal = 'aal2' for admin data and the trusted teacher role for teacher data."}, {"id": "readme_admin_dashboard_route", "label": "/admin-dashboard Server Route", "file_type": "code", "source_file": "README.md", "source_location": "README.md:36, 49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independently verifies authenticated user, admin role, and AAL2 on the server before rendering, so client-side navigation cannot bypass admin checks."}, {"id": "readme_teacher_dashboard_route", "label": "/teacher-dashboard Server Route", "file_type": "code", "source_file": "README.md", "source_location": "README.md:35, 50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independently verifies the authenticated user and teacher role on the server; the Supabase cookie-refresh proxy is explicitly not the authorization boundary."}, {"id": "readme_search_api", "label": "Dashboard Search API (GET /api/search)", "file_type": "code", "source_file": "README.md", "source_location": "README.md:55-65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server derives role and teacher ID from the authenticated session and membership tables so callers cannot choose a role or teacher scope; this prevents horizontal privilege escalation through query parameters."}, {"id": "readme_search_filter_key", "label": "SearchFilterKey", "file_type": "code", "source_file": "README.md", "source_location": "README.md:122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_filter_definitions", "label": "FILTER_DEFINITIONS", "file_type": "code", "source_file": "README.md", "source_location": "README.md:122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declares per-role and per-entity filter visibility in one place, keeping authorization of filterable fields declarative."}, {"id": "readme_entity_configs", "label": "entityConfigs", "file_type": "code", "source_file": "README.md", "source_location": "README.md:122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_validation_ts", "label": "Search validation.ts", "file_type": "code", "source_file": "README.md", "source_location": "README.md:122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_query_builder_ts", "label": "Search query-builder.ts", "file_type": "code", "source_file": "README.md", "source_location": "README.md:118, 122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applies the trusted teacher scope before all user-supplied filters, so participant rows are scoped by the linked student's teacher_id and guest/other-teacher students are never exposed."}, {"id": "readme_search_filter_component", "label": "SearchFilter UI Component", "file_type": "code", "source_file": "README.md", "source_location": "README.md:57, 122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_search_migration", "label": "Search Views and Indexes Migration (202610290001)", "file_type": "code", "source_file": "README.md", "source_location": "README.md:118-120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assumes public.student, public.teacher, public.quiz, public.quiz_session, and public.participant with the columns used by the views; view definitions and indexes must be adapted if the deployed schema differs."}, {"id": "readme_security_invoker_views", "label": "security_invoker Search Views", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:118", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "security_invoker views run with the caller's permissions so existing table grants and RLS policies still govern which teacher/admin rows are visible."}, {"id": "readme_pg_trgm_indexes", "label": "pg_trgm GIN Trigram Indexes", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trigram indexes support %term% ILIKE substring searches without requiring a separate full-text search language configuration; B-tree indexes cover teacher/status/date/join columns, and password columns are intentionally excluded from views and indexes."}, {"id": "readme_search_data_source", "label": "SEARCH_DATA_SOURCE Environment Switch", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:118", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local development defaults to deterministic mock data while production defaults to Supabase, allowing demos and tests without a live database."}, {"id": "readme_dashboard_routes", "label": "Application Route Map", "file_type": "document", "source_file": "README.md", "source_location": "README.md:25-36", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_webpack_build", "label": "Webpack Build Configuration", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The project builds with Webpack because Turbopack native bindings are unavailable in the current Windows environment."}, {"id": "readme_android_apk", "label": "Fili-QuizMo Android APK (1.0.0)", "file_type": "document", "source_file": "README.md", "source_location": "README.md:127", "source