{"nodes": [{"id": "public_assets_true_false_quiz_true_or_false_quiz", "label": "True or False Quiz Screen", "file_type": "image", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-screen mobile quiz mode presented as a retro pixel-art game: a compact HUD at the top, one question card in the center, two large answer buttons, and a persistent NEXT control pinned to the bottom so the primary action stays thumb-reachable."}, {"id": "public_assets_true_false_quiz_question_card", "label": "Question Card (TANONG 1)", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cream paper-like panel with a gold header band and blue dotted divider; isolates the question from the answer buttons so the learner reads before acting, and the bold 'TANONG 1' header gives an arcade-style sense of progression."}, {"id": "public_assets_true_false_quiz_instruction_text", "label": "Instruction Text (Sagutin ng TRUE or FALSE lamang.)", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_assets_true_false_quiz_albanya_question", "label": "Albanya Dark Forest Question Text", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Question text is a Filipino literary-comprehension claim about the dark forest outside Albanya where the story begins, indicating the quiz bank is drawn from Philippine literature (Florante at Laura) rather than generic trivia."}, {"id": "public_assets_true_false_quiz_true_button", "label": "TRUE Answer Button", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blue fill with a check-mark glyph: blue/check reads as the affirmative, 'correct-leaning' choice, and the oversized full-width target maximizes tap accuracy on a phone."}, {"id": "public_assets_true_false_quiz_false_button", "label": "FALSE Answer Button", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orange fill with an X glyph, visually contrasted against the blue TRUE button so the binary choice is distinguishable at a glance without relying on reading."}, {"id": "public_assets_true_false_quiz_next_button", "label": "NEXT Button", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Green bottom-anchored action bar separated from the answer pair, so advancing to the next item is a distinct, deliberate step rather than an accidental tap next to an answer."}, {"id": "public_assets_true_false_quiz_progress_bar", "label": "Question Progress Segments", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ten discrete segments (one filled yellow) instead of a continuous bar: the blocky meter matches the pixel-art language and makes the 10-question set countable."}, {"id": "public_assets_true_false_quiz_question_counter", "label": "Question Counter (1/10)", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_assets_true_false_quiz_timer_score", "label": "Timer and Score HUD", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clock icon with a red draining bar plus an 'S' score badge sit in the top-right: time pressure and scoring are surfaced continuously so performance is visible during, not only after, the quiz."}, {"id": "public_assets_true_false_quiz_exit_button", "label": "Exit Button", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_assets_true_false_quiz_quiz_mode_label", "label": "Quiz Mode Label (True or False)", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_assets_true_false_quiz_pixel_art_style", "label": "Pixel-Art Retro Visual Style", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chunky borders, monospace pixel font, hard drop shadows and a low-resolution city skyline strip deliberately mimic an 8-bit arcade game, likely to make an educational assessment feel playful and less test-like for students."}, {"id": "public_assets_true_false_quiz_filipino_localization", "label": "Filipino Language Localization", "file_type": "concept", "source_file": "public/assets/true_false_quiz.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All prompts and labels are in Filipino except the TRUE/FALSE answer tokens, which are kept in English as fixed answer vocabulary so the binary choice stays unambiguous."}, {"id": "public_assets_true_false_quiz_city_skyline_backd